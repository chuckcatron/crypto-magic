# ─────────────────────────────────────────────────────────────────────────────
#  crypto-magic — copy to .env and edit.  NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Execution mode ───────────────────────────────────────────────────────────
# paper : real market data, simulated money. Needs no API key at all.
# live  : real orders, real money.
TRADING_MODE=paper

# Live mode ALSO requires this exact phrase. Two separate switches, on purpose —
# so live can never be reached by flipping one variable or one typo.
# LIVE_TRADING_ACK=I_UNDERSTAND_THIS_SPENDS_REAL_MONEY

# ── Coinbase credentials (only needed for TRADING_MODE=live) ─────────────────
# Create at https://portal.cdp.coinbase.com → API keys.
# Grant "Trade" and "View". Do NOT grant Transfer/Withdraw — this bot never
# needs to move money off the exchange, and a key that cannot withdraw cannot
# be used to drain the account.
# Restrict the key to your home IP if you can.
# COINBASE_API_KEY_NAME=organizations/xxxxxxxx/apiKeys/xxxxxxxx
# The PEM, newlines written as \n, wrapped in double quotes:
# COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\nMHc...\n-----END EC PRIVATE KEY-----\n"

# ── What to trade ────────────────────────────────────────────────────────────
PRODUCTS=BTC-USD
GRANULARITY=ONE_HOUR
QUOTE_CURRENCY=USD

# ── Hard risk caps (enforced on every order, independent of the strategy) ────
MAX_TOTAL_NOTIONAL=100      # ceiling on ALL open positions combined
MAX_POSITION_NOTIONAL=25    # ceiling on any single position
MAX_OPEN_POSITIONS=4
RISK_PER_TRADE_PCT=1        # % of equity risked between entry and stop
MAX_DAILY_LOSS=10           # realized loss in a UTC day that halts new entries
MAX_CONSECUTIVE_LOSSES=4    # losing streak that halts new entries
MAX_ORDERS_PER_HOUR=12      # blast radius of a runaway loop
MAX_SLIPPAGE_PCT=0.5        # a fill worse than this engages the kill switch
MIN_ORDER_NOTIONAL=1        # exchange minimum

# ── Strategy (ta-ensemble-v1) ────────────────────────────────────────────────
EMA_FAST_PERIOD=12
EMA_SLOW_PERIOD=26
EMA_TREND_PERIOD=200
RSI_PERIOD=14
RSI_ENTRY_MIN=45            # below this a bullish cross is a dead-cat bounce
RSI_ENTRY_MAX=80            # above this we would be chasing a parabolic move
RSI_EXIT_MAX=88             # blow-off top: leave
ATR_PERIOD=14
ATR_STOP_MULTIPLE=2         # initial stop, in ATRs below entry
ATR_TAKE_PROFIT_MULTIPLE=4  # 0 disables the fixed target and lets the trail run
MIN_ATR_PCT=0.15            # quieter than this and fees eat the move
MAX_ATR_PCT=8               # wilder than this and a fixed stop cannot survive
REQUIRE_TREND_FILTER=true   # only buy above the long trend EMA
MIN_CONFIDENCE=0.35

# ── Position management ──────────────────────────────────────────────────────
TRAILING_STOP_ENABLED=true
TRAIL_ACTIVATION_ATR_MULTIPLE=1   # don't trail until the trade is 1 ATR ahead
MAX_HOLDING_BARS=240
PROTECTIVE_STOP_ENABLED=true      # exchange-side stop that outlives the process
PROTECTIVE_STOP_SLACK_ATR=0.5     # it sits this far BELOW the engine's own stop

# ── Loop timing ──────────────────────────────────────────────────────────────
STOP_MONITOR_INTERVAL_SECONDS=30  # how often open positions are re-checked
MAX_MARKET_DATA_AGE_BARS=2        # halt entries after missing this many bars

# ── Alerting ─────────────────────────────────────────────────────────────────
# A bot running 24/7 behind a dashboard you have to remember to open is not
# monitored — it is unobserved. Configure at least one channel before going live.
# Pick any or all; each is tried independently so one being down does not stop
# the others.

# ntfy — easiest to actually receive on a phone. Install the ntfy app, subscribe
# to a topic, done. No account, no bot to register.
# The topic IS the secret: anyone who knows it can read your alerts, so use a
# long random one. Alert bodies never contain keys or balances.
# NTFY_TOPIC=crypto-magic-8f3k2p9wqz
NTFY_SERVER=https://ntfy.sh

# Discord — Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# Telegram — message @BotFather to create a bot, then message your bot once and
# read the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# 'warning' = only problems reach you. 'info' adds every position open/close.
ALERT_MIN_SEVERITY=warning
# The same recurring condition is re-sent at most this often. The engine retries
# a failing exchange call every 30s; without this that is 120 pages an hour, you
# mute the channel, and then you miss the one that mattered.
ALERT_COOLDOWN_SECONDS=900
# Ceiling on non-critical alerts per hour. CRITICAL always gets through.
ALERT_MAX_PER_HOUR=12

# Daily "still alive" message. Alerts can only fire while the process is running,
# so a message that does NOT arrive is the only way a dead bot can signal you.
HEARTBEAT_ENABLED=true
HEARTBEAT_UTC_HOUR=13

# Dead-man's switch: the one alert that still works when the Mac is off.
# The engine pings this URL every DEADMAN_INTERVAL_SECONDS while its trading
# loop is healthy; an outside monitor alerts you when the pings STOP.
# healthchecks.io (free tier) works: create a check, paste its ping URL here.
# Treat the URL as a secret. Setup: docs/REMOTE-ACCESS.md
# DEADMAN_PING_URL=https://hc-ping.com/your-check-uuid
DEADMAN_INTERVAL_SECONDS=60

# ── Local LLM (Ollama) — advisory only ───────────────────────────────────────
# The model reads trades that have ALREADY CLOSED and writes prose about them.
# It has no path to an order, a position or a risk limit. Turning it off changes
# nothing about how the bot trades.
#
#   brew install ollama && ollama serve
#   ollama pull llama3.1:8b
LLM_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_KEEP_ALIVE=5m         # keep the model resident between reviews; 0 to unload
LLM_TIMEOUT_MS=120000
LLM_MAX_TOKENS=700

POSTMORTEM_ENABLED=true
POSTMORTEM_INTERVAL_SECONDS=300

# ── News (post-mortem context only — never an input to a trade) ──────────────
# Headlines from a trade's own window are shown to the model when it reviews
# that trade. Nothing here can affect an entry or an exit.
# Key from https://cryptopanic.com/developers/api/ — note the v2 API is served
# from /api/{plan}/v2/ and per-currency filtering is plan-gated.
NEWS_ENABLED=false
# CRYPTOPANIC_API_KEY=
CRYPTOPANIC_PLAN=developer
# CRYPTOPANIC_BASE_URL=       # override if your plan's URL differs
NEWS_LEAD_IN_HOURS=6          # also include headlines from before entry

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=4000
LOG_LEVEL=info
DATABASE_PATH=./data/crypto-magic.db
KILL_SWITCH_FILE=./data/KILL_SWITCH
PAPER_STARTING_CASH=1000
